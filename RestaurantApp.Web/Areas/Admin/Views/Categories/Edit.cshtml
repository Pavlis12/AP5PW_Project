@model RestaurantApp.Domain.Entities.MenuCategory

@{
    ViewData["Title"] = "Upravit kategorii";
}

<h1>Upravit kategorii</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">Název kategorie</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label">Popis (volitelné)</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Uložit změny</button>
                <a asp-action="Index" class="btn btn-secondary">Zpět na výpis</a>
            </div>
        </form>
    </div>
</div>