@model IEnumerable<RestaurantApp.Domain.Entities.RestaurantTable>

@{
    ViewData["Title"] = "Správa stolů";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Správa stolů</h1>
    <a asp-action="Create" class="btn btn-success">Přidat nový stůl</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Číslo stolu</th>
            <th>Počet míst</th>
            <th>Umístění</th>
            <th>Akce</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>Stůl č. @item.TableNumber</td>
                <td>@item.Seats míst</td>
                <td>@(string.IsNullOrEmpty(item.Location) ? "-" : item.Location)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Upravit</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Opravdu chcete smazat tento stůl?');">
                        <button type="submit" class="btn btn-sm btn-danger">Smazat</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>