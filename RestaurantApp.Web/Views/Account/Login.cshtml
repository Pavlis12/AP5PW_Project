@{
    ViewData["Title"] = "Přihlášení";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <h2>Přihlášení</h2>
        <hr />
        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="email" class="form-label">E-mail</label>
                <input type="email" name="email" id="email" class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Heslo</label>
                <input type="password" name="password" id="password" class="form-control" required />
            </div>

            <div class="form-check mb-3">
                <input type="checkbox" name="rememberMe" value="true" id="rememberMe" class="form-check-input" />
                <label for="rememberMe" class="form-check-label">Zapamatovat si mě</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Přihlásit se</button>
        </form>

        <div class="mt-3 text-center">
            <a asp-action="Register">Nemáte účet? Zaregistrujte se</a>
        </div>
    </div>
</div>