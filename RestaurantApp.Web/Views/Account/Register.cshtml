@{
    ViewData["Title"] = "Registrace";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <h2>Registrace nového účtu</h2>
        <hr />
        <form asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="email" class="form-label">E-mail</label>
                <input type="email" name="email" id="email" class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Heslo</label>
                <input type="password" name="password" id="password" class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Potvrzení hesla</label>
                <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-success w-100">Zaregistrovat se</button>
        </form>

        <div class="mt-3 text-center">
            <a asp-action="Login">Už máte účet? Přihlaste se</a>
        </div>
    </div>
</div>