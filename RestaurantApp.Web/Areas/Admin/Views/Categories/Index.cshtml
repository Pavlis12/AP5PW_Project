@model IEnumerable<RestaurantApp.Domain.Entities.MenuCategory>

@{
    ViewData["Title"] = "Správa kategorií";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Správa kategorií</h1>
    <a asp-action="Create" class="btn btn-success">Přidat novou kategorii</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Název kategorie</th>
            <th>Popis</th>
            <th>Akce</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Upravit</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Opravdu chcete smazat tuto kategorii?');">
                        <button type="submit" class="btn btn-sm btn-danger">Smazat</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>