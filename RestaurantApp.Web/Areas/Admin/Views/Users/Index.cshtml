@model IEnumerable<RestaurantApp.Domain.DTOs.UserDto>

@{
    ViewData["Title"] = "Správa uživatelů";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Správa uživatelů</h1>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Uživatelské jméno</th>
            <th>E-mail</th>
            <th>Role</th>
            <th>Akce</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-secondary")">@user.Role</span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Upravit</a>
                    @if (user.Email != User.Identity?.Name)
                    {
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Opravdu chcete smazat tohoto uživatele?');">
                            <button type="submit" class="btn btn-sm btn-danger">Smazat</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>