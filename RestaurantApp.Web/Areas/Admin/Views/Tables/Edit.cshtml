@model RestaurantApp.Domain.Entities.RestaurantTable

@{
    ViewData["Title"] = "Upravit stůl";
}

<h1>Upravit stůl</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="TableNumber" class="control-label">Číslo stolu</label>
                <input asp-for="TableNumber" type="number" class="form-control" />
                <span asp-validation-for="TableNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Seats" class="control-label">Počet míst (kapacita)</label>
                <input asp-for="Seats" type="number" class="form-control" />
                <span asp-validation-for="Seats" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Location" class="control-label">Umístění (volitelné)</label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Uložit změny</button>
                <a asp-action="Index" class="btn btn-secondary">Zpět na výpis</a>
            </div>
        </form>
    </div>
</div>